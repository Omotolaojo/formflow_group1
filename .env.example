# This file documents variable names only. Never place real production secrets here.

# Public URL used by the browser and CORS, for example http://20.10.30.40
PUBLIC_BASE_URL=http://localhost

# PostgreSQL
POSTGRES_USER=formflow
POSTGRES_DB=formflow
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Backend
NODE_ENV=production
PORT=5000
JWT_SECRET=replace-with-at-least-32-random-bytes
CORS_ORIGINS=http://localhost

# Optional first administrator. The deployment script enables creation only when
# both ADMIN_EMAIL and ADMIN_PASSWORD are supplied.
ADMIN_NAME=FormFlow Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional Azure Document Intelligence
AZURE_ENDPOINT=
AZURE_API_KEY=

# Azure Blob Storage
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER_NAME=receipts

# Frontend server-side backend URL inside Docker
BACKEND_API_URL=http://backend:5000/api
# Browser-side API base URL. This value is embedded at frontend build time.
NEXT_PUBLIC_API_URL=http://localhost
